.fields-group
  = form.input :starts_at,
               html5: true,
               include_blank: true,
               input_html: { pattern: datetime_pattern, placeholder: datetime_placeholder },
               wrapper: :with_block_label
  = form.input :ends_at,
               html5: true,
               include_blank: true,
               input_html: { pattern: datetime_pattern, placeholder: datetime_placeholder },
               wrapper: :with_block_label

.fields-group
  = form.input :all_day,
               as: :boolean,
               wrapper: :with_label

.fields-group
  %label.form-label= t('simple_form.labels.announcement.text', default: 'Content')
  - initial_media = form.object.media_attachments.map do |attachment|
    - { id: attachment.id.to_s,
        type: attachment.type,
        url: attachment.file.url(:original),
        preview_url: attachment.file.styles.key?(:small) ? attachment.file.url(:small) : attachment.file.url(:original),
        description: attachment.description }
  - editor_props = { initialText: form.object.text.to_s,
                     initialContentType: form.object.content_type.presence || 'text/markdown',
                     initialMedia: initial_media,
                     maxMediaAttachments: Announcement::MAX_MEDIA_ATTACHMENTS }
  %div{ data: { admin_component: 'announcement_editor', props: editor_props.to_json } }

- unless form.object.published?
  .fields-group
    = form.input :scheduled_at,
                 html5: true,
                 include_blank: true,
                 input_html: { pattern: datetime_pattern, placeholder: datetime_placeholder },
                 wrapper: :with_block_label

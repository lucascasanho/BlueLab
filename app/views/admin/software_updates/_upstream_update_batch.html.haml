%article.upstream-update{ id: dom_id(upstream_update_batch), class: upstream_update_batch.reviewed_at? ? 'upstream-update--reviewed' : nil }
  .upstream-update__header
    %div
      %h3
        = link_to "Mastodon #{upstream_update_batch.version}", upstream_update_batch.release_url, target: '_blank', rel: 'noopener noreferrer'
        - if upstream_update_batch.stable_release?
          %span.upstream-update__badge= t('admin.software_updates.upstream.release_badge.stable')
        - else
          %span.upstream-update__badge= t('admin.software_updates.upstream.release_badge.prerelease')
      .upstream-update__meta
        - source = upstream_update_batch.stable_release? ? t('admin.software_updates.upstream.source.stable') : t('admin.software_updates.upstream.source.prerelease', channel: upstream_update_batch.channel)
        = t('admin.software_updates.upstream.batch_meta', source: source, date: l(upstream_update_batch.detected_at, format: :long))
        - if upstream_update_batch.published_at.present?
          = " · #{t('admin.software_updates.upstream.published_at', date: l(upstream_update_batch.published_at, format: :long))}"
    - if upstream_update_batch.reviewed_at?
      %span.upstream-update__reviewed= t('admin.software_updates.upstream.reviewed_badge')

  %p.upstream-update__compatibility
    = material_symbol('info')
    = t('admin.software_updates.upstream.compatibility', installed: Mastodon::Version.to_s, available: upstream_update_batch.version)

  .upstream-update__actions
    = link_to t('admin.software_updates.upstream.view_official'), upstream_update_batch.release_url, target: '_blank', rel: 'noopener noreferrer', class: 'button button-secondary'
    - unless upstream_update_batch.reviewed_at?
      = button_to t('admin.software_updates.upstream.mark_reviewed'), review_upstream_admin_software_updates_path(batch_id: upstream_update_batch.id), method: :post, class: 'button button-secondary'

- content_for :page_title do
  = t('admin.verification_requests.title')

.filters
  .filter-subset
    %strong= t('admin.verification_requests.status')
    %ul
      %li= filter_link_to t('admin.verification_requests.pending'), status: 'pending'
      %li= filter_link_to t('admin.verification_requests.all'), status: 'all'
      %li= filter_link_to t('admin.verification_requests.resolved'), status: 'resolved'

- if @verification_requests.empty?
  = nothing_here 'nothing-here--under-tabs'
- else
  .announcements-list.verification-requests-list
    - @verification_requests.each do |verification_request|
      .announcements-list__item
        = link_to admin_verification_request_path(verification_request), class: 'announcements-list__item__title' do
          = t('admin.verification_requests.request_title', id: verification_request.id)

        .announcements-list__item__action-bar.verification-request-action-bar
          .announcements-list__item__meta
            = admin_account_link_to verification_request.account
            |
            %time.time-ago{ datetime: verification_request.created_at.iso8601, title: l(verification_request.created_at) }
              = l(verification_request.created_at)
            |
            = t("admin.verification_requests.status_#{verification_request.status}")

          .announcements-list__item__actions.verification-request-actions
            = link_to t('admin.verification_requests.view'), admin_verification_request_path(verification_request), class: 'button button-secondary button--compact'
            - if verification_request.pending?
              = button_to t('admin.verification_requests.approve'), approve_admin_verification_request_path(verification_request), method: :post, class: 'button button-secondary button--compact', data: { confirm: t('admin.accounts.are_you_sure') }
              = button_to t('admin.verification_requests.deny'), deny_admin_verification_request_path(verification_request), method: :post, class: 'button button--dangerous button--compact', data: { confirm: t('admin.accounts.are_you_sure') }
        
  = paginate @verification_requests

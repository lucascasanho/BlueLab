- content_for :page_title do
  = t('auth.login')

- content_for :blue2_auth_title do
  = t('auth.login')

- content_for :blue2_auth_subtitle do
  = t('auth.sign_in.preamble_html', domain: site_hostname)

- content_for :header_tags do
  = render partial: 'shared/og'

- unless omniauth_only?
  = simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .sign-in-introduction
      %h1.title= t('auth.sign_in.title', domain: site_hostname)
      %p.lead= t('auth.sign_in.preamble_html', domain: site_hostname)
    .fields-group
      = f.input :email,
                as: :string,
                autofocus: true,
                required: true,
                hint: false,
                input_html: { 'aria-label': t('simple_form.labels.defaults.username_or_email'), autocomplete: 'username webauthn' },
                label: t('simple_form.labels.defaults.username_or_email'),
                wrapper: :with_label
    .fields-group
      = f.input :password,
                required: true,
                hint: false,
                input_html: { 'aria-label': t('simple_form.labels.defaults.password'), autocomplete: 'current-password' },
                label: t('simple_form.labels.defaults.password'),
                wrapper: :with_label

    .actions
      = f.button :button, t('auth.login'), type: :submit, class: 'blue2-login-submit'

  .simple_form.alternative-login
    %h2= t('auth.or_log_in_with')
    %p.flash-message.passkey-message.hidden#unsupported-browser-message= t('passkeys.not_supported')
    %p.flash-message.passkey-message.alert.hidden#passkey-error-message{ data: { error_message: t('passkeys.authentication_error'), cancelled_message: t('passkeys.cancelled') } }= t('passkeys.authentication_error')
    %form#passkey-authentication-form
      .actions
        %button.button.btn.js-passkey-authentication{ type: 'submit' }= t('passkeys.sign_in')

  = vite_typescript_tag 'two_factor_authentication.ts', crossorigin: 'anonymous'

- if devise_mapping.omniauthable? && resource_class.omniauth_providers.any?
  .simple_form.alternative-login
    - if omniauth_only?
      %h1= t('auth.log_in_with')
    - else
      %h2= t('auth.or_log_in_with')

    .actions
      - resource_class.omniauth_providers.each do |provider|
        = provider_sign_in_link(provider)

- unless within_authorization_flow?
  .form-footer= render 'auth/shared/links'

- content_for :header_tags do
  = render_initial_state
  = vite_typescript_tag 'public.tsx', crossorigin: 'anonymous'
  = vite_typescript_tag 'admin.tsx', crossorigin: 'anonymous'

- content_for :body_classes, 'admin'
- blue2_theme = current_theme == 'blue-2'

- content_for :content do
  - mobile_page_title = strip_tags(content_for(:page_title)).strip
  %a.navigation-skip-link{ href: '#content' }= t('admin.skip_to_content')
  .admin-wrapper
    %header.sidebar-wrapper
      .sidebar-wrapper__inner
        .sidebar
          - if blue2_theme
            = link_to root_path, class: 'blue2-admin-brand' do
              = image_tag(favicon_path(48) || frontend_asset_path('icons/favicon-48x48.png'), alt: '')
              %span= Setting.site_title
          - else
            = link_to root_path do
              = render_logo

          .sidebar__toggle
            .sidebar__toggle__logo{ class: ('sidebar__toggle__logo--page-title' if mobile_page_title.present?) }
              = link_to root_path, data: { title: mobile_page_title } do
                - if blue2_theme
                  = image_tag(favicon_path(48) || frontend_asset_path('icons/favicon-48x48.png'), alt: '')
                  %span= Setting.site_title
                - else
                  = logo_as_symbol(:wordmark)

            = link_to '#', class: 'sidebar__toggle__icon', 'aria-label': t('navigation.toggle_menu'), 'aria-expanded': 'false' do
              = material_symbol 'menu'
              = material_symbol 'close'

          %nav
            = render_navigation

    %main.content-wrapper#content
      .content
        .content__heading
          - if content_for?(:heading)
            = yield :heading
          - else
            .content__heading__row
              %h1= yield :page_title

              - if content_for?(:heading_actions)
                .content__heading__actions
                  = yield :heading_actions

        = render 'application/flashes'

        = yield

    .sidebar-wrapper.sidebar-wrapper--empty

= render template: 'layouts/application'

- bluelab_error = Setting.theme == 'blue-2' && response.status == 404

!!!
%html{ lang: I18n.locale, 'data-theme' => (bluelab_error ? 'blue-2' : nil), 'data-contrast' => 'auto', 'data-color-scheme' => 'auto', 'data-system-theme' => (bluelab_error ? 'true' : nil) }
  %head
    %meta{ 'content' => 'text/html; charset=UTF-8', 'http-equiv' => 'Content-Type' }/
    %meta{ charset: 'utf-8' }/
    %title= safe_join([yield(:page_title), Setting.default_settings['site_title']], ' - ')
    %meta{ content: 'width=device-width,initial-scale=1', name: 'viewport' }/

    - if bluelab_error
      = vite_client_tag
      = vite_react_refresh_tag
      = vite_polyfills_tag
      = vite_typescript_tag 'theme-selection.ts', crossorigin: 'anonymous', blocking: 'render'
      = theme_style_tags 'blue-2'
      = instance_customization_styles
      = theme_color_tags 'auto'
    - else
      = vite_client_tag
      = vite_react_refresh_tag
      = vite_polyfills_tag
      = vite_typescript_tag 'theme-selection.ts', crossorigin: 'anonymous', blocking: 'render'
      = theme_style_tags Setting.default_settings['theme']
      = vite_typescript_tag 'error.ts', crossorigin: 'anonymous'

  %body{ class: (bluelab_error ? 'error error--bluelab' : 'error'), data: (bluelab_error ? { theme: 'blue-2' } : nil) }
    - if bluelab_error
      %main.error-page
        .error-page__brand
          = image_tag(instance_presenter.auth_logo&.file&.url || favicon_path(48) || frontend_asset_path('icons/favicon-48x48.png'), alt: '', class: 'error-page__icon')
          %span= Setting.site_title

        .error-page__content
          .error-page__code 404
          %h1= yield :content
          .error-page__actions
            = link_to root_path, class: 'button error-page__home' do
              = material_symbol('home', whitespace: false)
              = t('errors.go_home')
            %a.button.button-secondary.error-page__report{ href: "/bug_reports/new?error_page=#{response.status}&current_path=#{ERB::Util.url_encode(request.path)}", target: '_self', data: { turbo: false } }= t('bug_reports.link')
    - else
      %main.dialog
        .dialog__illustration
          %img{ alt: Setting.default_settings['site_title'], src: '/oops.png' }/
        .dialog__message
          %h1= yield :content
          .dialog__actions
            %a{ class: 'button button-secondary', href: '/' }= t('errors.go_home')
            %a.button.button-secondary.error-page__report{ href: "/bug_reports/new?error_page=#{response.status}&current_path=#{ERB::Util.url_encode(request.path)}", target: '_self', data: { turbo: false } }= t('bug_reports.link')

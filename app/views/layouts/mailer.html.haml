:ruby
  instance_accent_color = safe_customization_color(:instance_accent_color, fallback: '#2b8fcd')
  instance_light_background_color = safe_customization_color(:instance_light_background_color, fallback: '#ffffff')
  instance_light_surface_color = safe_customization_color(:instance_light_surface_color, fallback: '#f7f9fa')
  instance_light_text_color = safe_customization_color(:instance_light_text_color, fallback: '#0f1419')
  instance_dark_background_color = safe_customization_color(:instance_dark_background_color, fallback: '#000000')
  instance_dark_surface_color = safe_customization_color(:instance_dark_surface_color, fallback: '#16181c')
  instance_dark_text_color = safe_customization_color(:instance_dark_text_color, fallback: '#f7f9f9')

  email_color_keys = %w(
    email_primary_color
    email_button_color
    email_link_color
    email_background_color
    email_surface_color
    email_text_color
    email_muted_color
    email_dark_background_color
    email_dark_surface_color
    email_dark_text_color
    email_dark_muted_color
  )
  explicit_email_colors = Setting.where(var: email_color_keys).pluck(:var)
  email_color = ->(key, fallback) do
    explicit_email_colors.include?(key.to_s) ? safe_customization_color(key, fallback: fallback) : fallback
  end

  email_primary_color = email_color.call(:email_primary_color, instance_accent_color)
  email_button_color = email_color.call(:email_button_color, instance_accent_color)
  email_link_color = email_color.call(:email_link_color, instance_accent_color)
  email_background_color = email_color.call(:email_background_color, instance_light_background_color)
  email_surface_color = email_color.call(:email_surface_color, instance_light_surface_color)
  email_text_color = email_color.call(:email_text_color, instance_light_text_color)
  email_muted_color = email_color.call(:email_muted_color, '#536471')
  email_dark_background_color = email_color.call(:email_dark_background_color, instance_dark_background_color)
  email_dark_surface_color = email_color.call(:email_dark_surface_color, instance_dark_surface_color)
  email_dark_text_color = email_color.call(:email_dark_text_color, instance_dark_text_color)
  email_dark_muted_color = email_color.call(:email_dark_muted_color, '#8b98a5')
  email_border_color = '#d8e0e8'
  email_dark_border_color = '#2f3336'
!!!
%html{ lang: I18n.locale, dir: locale_direction }
  %head
    %meta{ 'charset' => 'utf-8' }
    %title= Setting.site_title
    %meta{ name: 'x-apple-disable-message-reformatting' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
    %meta{ name: 'format-detection', content: 'telephone=no, date=no, address=no, email=no, url=no' }
    %meta{ name: 'color-scheme', content: 'light dark' }
    %meta{ name: 'supported-color-schemes', content: 'light dark' }
    %style
      \table { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      \body, .email { background-color: #{email_background_color} !important; color: #{email_text_color} !important; }
      \.email-card-td,
      \.email-inner-card-td,
      \.email-inner-card-td-without-padding,
      \.email-inner-nested-card-td,
      \.email-header-card-table,
      \.email-account-banner-icon-table,
      \.email-checklist-table,
      \.email-mini-td,
      \.email-feature-td,
      \.email-body-td { background-color: #{email_surface_color} !important; border-color: #{email_border_color} !important; }
      \.email-header-td,
      \.email-header-after-inside-div { background-color: #{email_surface_color} !important; border-color: #{email_border_color} !important; }
      \.email-header-td { border-top: 4px solid #{email_primary_color} !important; border-bottom: 1px solid #{email_border_color} !important; }
      \.email-header-brand-text,
      \.email-header-heading-txt-td h1,
      \.email-account-name,
      \.email-account-stats-table b,
      \.email-header-card-instance,
      \.email-body-padding-td > p,
      \.email-h2,
      \.email-status-header-name,
      \.email-quote-header-name,
      \.email-status-prose p,
      \.email-status-media,
      \.email-checklist-text-td h3,
      \.email-mini-follow-text-td h3,
      \.email-mini-hashtag-td h3,
      \.email-prose p,
      \.email-prose ul,
      \.email-prose ol { color: #{email_text_color} !important; }
      \.email-header-heading-txt-td p,
      \.email-header-logo-p,
      \.email-account-handle,
      \.email-account-stats-table td,
      \.email-header-card-description,
      \.email-h-sub,
      \.email-p,
      \.email-status-header-handle,
      \.email-quote-header-handle,
      \.email-status-spoiler,
      \.email-status-footer,
      \.email-checklist-text-td p,
      \.email-mini-follow-text-td p,
      \.email-mini-hashtag-td p,
      \.email-footer-p,
      \.email-footer-p a { color: #{email_muted_color} !important; }
      \.email-prose a,
      \.email-status-prose a,
      \.email-link-with-arrow,
      \.email-column-action-td { color: #{email_link_color} !important; }
      \.email-btn-table { background-color: #{email_button_color} !important; }
      \.email-btn-a { color: #ffffff !important; }
      \.email-border-top,
      \.email-border-bottom,
      \.email-body-columns-td { border-color: #{email_border_color} !important; }
      \.email-account-banner-table,
      \.email-header-card-banner-td,
      \.email-frame-table { background-color: #{email_background_color} !important; }
    %style{ 'data-premailer': 'ignore' }
      \:root { color-scheme: light dark; supported-color-schemes: light dark; }
      \.email a { text-decoration-thickness: 1px; text-underline-offset: 2px; }
      \.email-btn-a { text-decoration: none !important; }
      \.email-btn-hover:hover { filter: brightness(0.9); }
      \.email-banner-text-td .email-btn-hover:hover { filter: brightness(1.05); }
      \@media (prefers-color-scheme: dark) {
      \  body, .email { background-color: #{email_dark_background_color} !important; color: #{email_dark_text_color} !important; }
      \  .email-card-td,
      \  .email-inner-card-td,
      \  .email-inner-card-td-without-padding,
      \  .email-inner-nested-card-td,
      \  .email-header-card-table,
      \  .email-account-banner-icon-table,
      \  .email-checklist-table,
      \  .email-mini-td,
      \  .email-feature-td,
      \  .email-body-td { background-color: #{email_dark_surface_color} !important; border-color: #{email_dark_border_color} !important; }
      \  .email-header-td,
      \  .email-header-after-inside-div { background-color: #{email_dark_surface_color} !important; border-color: #{email_dark_border_color} !important; }
      \  .email-header-td { border-top-color: #{email_primary_color} !important; border-bottom-color: #{email_dark_border_color} !important; }
      \  .email-account-banner-table,
      \  .email-header-card-banner-td,
      \  .email-frame-table { background-color: #{email_dark_background_color} !important; }
      \  .email-header-brand-text,
      \  .email-header-heading-txt-td h1,
      \  .email-account-name,
      \  .email-account-stats-table b,
      \  .email-header-card-instance,
      \  .email-body-padding-td > p,
      \  .email-h2,
      \  .email-status-header-name,
      \  .email-quote-header-name,
      \  .email-status-prose p,
      \  .email-status-media,
      \  .email-checklist-text-td h3,
      \  .email-mini-follow-text-td h3,
      \  .email-mini-hashtag-td h3,
      \  .email-prose p,
      \  .email-prose ul,
      \  .email-prose ol { color: #{email_dark_text_color} !important; }
      \  .email-header-heading-txt-td p,
      \  .email-header-logo-p,
      \  .email-account-handle,
      \  .email-account-stats-table td,
      \  .email-header-card-description,
      \  .email-h-sub,
      \  .email-p,
      \  .email-status-header-handle,
      \  .email-quote-header-handle,
      \  .email-status-spoiler,
      \  .email-status-footer,
      \  .email-checklist-text-td p,
      \  .email-mini-follow-text-td p,
      \  .email-mini-hashtag-td p,
      \  .email-footer-p,
      \  .email-footer-p a { color: #{email_dark_muted_color} !important; }
      \  .email-prose a,
      \  .email-status-prose a,
      \  .email-link-with-arrow,
      \  .email-column-action-td { color: #{email_primary_color} !important; }
      \  .email-border-top,
      \  .email-border-bottom,
      \  .email-body-columns-td { border-color: #{email_dark_border_color} !important; }
      \  .email-checklist-checked { background-color: #0f2f27 !important; border-color: #00ba7c !important; }
      \}
      \[data-ogsc] .email,
      \[data-ogsc] .email-body-td,
      \[data-ogsc] .email-card-td { background-color: #{email_dark_surface_color} !important; color: #{email_dark_text_color} !important; }
      \[data-ogsc] .email-header-td,
      \[data-ogsc] .email-header-after-inside-div { background-color: #{email_dark_surface_color} !important; border-color: #{email_dark_border_color} !important; }
      \[data-ogsc] .email-footer-p,
      \[data-ogsc] .email-footer-p a,
      \[data-ogsc] .email-p,
      \[data-ogsc] .email-h-sub { color: #{email_dark_muted_color} !important; }
    /[if mso]
      <xml>
      <o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office">
      <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
      </xml>
    = vite_stylesheet_tag 'styles/entrypoints/mailer.scss'
  %body
    .email{ dir: locale_direction }
      %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
        %tr
          %td.email-desktop-p-8
            .email-container
              /[if mso]
                <table border="0" cellpadding="0" cellspacing="0" align="center" style="width:740px;" role="presentation"><tr><td>
              %table.email-w-full.email-card-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-card-td.email-desktop-rounded-16px

                    -# Header
                    %table.email-header-table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                      %tr
                        %td.email-header-td

                          -# Logo
                          %table.email-header-logo-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                            %tr
                              %td.email-header-logo-td
                                /[if mso]
                                  <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="false" stroke="false" style="position:absolute; left:40px; top:26px; width:636px;"><v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0">
                                .email-header-logo-div
                                  %p.email-header-logo-p
                                    %span.email-header-logo-span
                                      = '/ '
                                      = site_hostname
                                /[if mso]
                                  </v:textbox></v:rect>
                                = link_to root_url, class: 'email-header-logo-a' do
                                  = image_tag(instance_presenter.email_logo&.file&.url || frontend_asset_url('images/mailer/logo.png'), alt: '', width: 40, height: 40)
                                  %span.email-header-brand-text= Setting.site_title

                          -# Heading
                          = yield :heading

                    .email-header-after-div
                      .email-header-after-inside-div
                    %table.email-body-table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                      %tr
                        %td.email-body-td
                          -# Content
                          = yield

              /[if mso]
                </td></tr></table>

            -# Footer
            .email-container
              /[if mso]
                <table border="0" cellpadding="0" cellspacing="0" align="center" style="width:740px;" role="presentation"><tr><td>
              %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-footer-td
                    - if content_for?(:footer)
                      = yield :footer
                    - else
                      %p.email-footer-p
                        = link_to root_url, class: 'email-footer-logo-a' do
                          = image_tag(instance_presenter.email_logo&.file&.url || frontend_asset_url('images/mailer/logo.png'), alt: Setting.site_title, width: 44, height: 44)
                      %p.email-footer-p
                        = t 'about.hosted_on', domain: site_hostname
                      %p.email-footer-p
                        = link_to t('application_mailer.notification_preferences'), settings_preferences_notifications_url
                        - if defined?(@unsubscribe_url)
                          ·
                          = link_to t('application_mailer.unsubscribe'), @unsubscribe_url
              /[if mso]
                </td></tr></table>

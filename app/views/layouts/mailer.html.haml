-# haml-lint:disable ViewLength
:ruby
  instance_accent_color = safe_customization_color(:instance_accent_color, fallback: '#2b8fcd')
  instance_light_background_color = safe_customization_color(:instance_light_background_color, fallback: '#ffffff')
  instance_light_surface_color = safe_customization_color(:instance_light_surface_color, fallback: '#f7f9fa')
  instance_light_text_color = safe_customization_color(:instance_light_text_color, fallback: '#0f1419')
  instance_dark_background_color = safe_customization_color(:instance_dark_background_color, fallback: '#000000')
  instance_dark_surface_color = safe_customization_color(:instance_dark_surface_color, fallback: '#16181c')
  instance_dark_text_color = safe_customization_color(:instance_dark_text_color, fallback: '#f7f9f9')

  mix_color = lambda do |foreground, background, foreground_weight|
    foreground_channels = foreground.delete_prefix('#').scan(/../).map { |channel| channel.to_i(16) }
    background_channels = background.delete_prefix('#').scan(/../).map { |channel| channel.to_i(16) }
    mixed_channels = foreground_channels.zip(background_channels).map do |foreground_channel, background_channel|
      ((foreground_channel * foreground_weight) + (background_channel * (1 - foreground_weight))).round
    end
    "##{mixed_channels.map { |channel| channel.to_s(16).rjust(2, '0') }.join}"
  end

  # Email presentation deliberately follows the same instance palette as the
  # web interface. Legacy email-specific Setting values are intentionally ignored.
  email_primary_color = instance_accent_color
  email_button_color = instance_accent_color
  email_link_color = instance_accent_color
  email_background_color = instance_light_background_color
  email_surface_color = instance_light_surface_color
  email_text_color = instance_light_text_color
  email_muted_color = mix_color.call(instance_light_text_color, instance_light_background_color, 0.64)
  email_dark_background_color = instance_dark_background_color
  email_dark_surface_color = instance_dark_surface_color
  email_dark_text_color = instance_dark_text_color
  email_dark_muted_color = mix_color.call(instance_dark_text_color, instance_dark_background_color, 0.64)
  email_border_color = mix_color.call(instance_light_text_color, instance_light_surface_color, 0.16)
  email_dark_border_color = mix_color.call(instance_dark_text_color, instance_dark_surface_color, 0.20)

  header_logo_path = instance_presenter.email_logo&.file&.url
  header_logo_url = full_asset_url(header_logo_path) if header_logo_path.present?
  footer_logo_upload = instance_presenter.favicon || instance_presenter.app_icon || instance_presenter.email_logo
  footer_logo_path = footer_logo_upload&.file&.url
  footer_logo_url = full_asset_url(footer_logo_path) if footer_logo_path.present?
!!!

!!!
%html{ lang: I18n.locale, dir: locale_direction }
  %head
    %meta{ 'charset' => 'utf-8' }
    %title Espelunca
    %meta{ name: 'x-apple-disable-message-reformatting' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
    %meta{ name: 'format-detection', content: 'telephone=no, date=no, address=no, email=no, url=no' }
    %meta{ name: 'color-scheme', content: 'light dark' }
    %meta{ name: 'supported-color-schemes', content: 'light dark' }
    %style
      \table { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    %style{ 'data-premailer': 'ignore' }
      \:root { color-scheme: light dark; supported-color-schemes: light dark; }
      \.email a { color: inherit; text-decoration: none; }
      \.email-btn-hover:hover { background-color: #563acc !important; }
      \.email-banner-text-td .email-btn-hover:hover { background-color: #fff !important; }
      \@media (prefers-color-scheme: dark) {
      \  body, .email { background-color: #1e2028 !important; color: #f7f9f9 !important; }
      \  .email-card-td, .email-inner-card-td, .email-inner-card-td-without-padding, .email-inner-nested-card-td, .email-header-card-table, .email-account-banner-icon-table, .email-checklist-table, .email-mini-td { background-color: #232543 !important; border-color: #38384d !important; }
      \  .email-account-banner-table, .email-header-card-banner-td { background-color: #393f4f !important; }
      \  .email-header-td, .email-header-after-inside-div, .email-banner-table { background-color: #1e2028 !important; }
      \  .email-body-td { background-color: #232543 !important; background-image: none !important; }
      \  .email-account-name, .email-account-stats-table b, .email-header-card-instance, .email-body-padding-td > p, .email-h2, .email-status-header-name, .email-quote-header-name, .email-status-prose p, .email-status-media, .email-checklist-text-td h3, .email-mini-follow-text-td h3, .email-mini-hashtag-td h3, .email-prose p, .email-prose ul, .email-prose ol { color: #f7f9f9 !important; }
      \  .email-account-handle, .email-account-stats-table td, .email-header-card-description, .email-h-sub, .email-p, .email-status-header-handle, .email-quote-header-handle, .email-status-spoiler, .email-status-footer, .email-checklist-text-td p, .email-mini-follow-text-td p, .email-mini-hashtag-td p, .email-footer-p, .email-footer-p a { color: #b8b3c0 !important; }
      \  .email-border-top, .email-border-bottom, .email-body-columns-td { border-color: #38384d !important; }
      \  .email-frame-table { background-color: #393f4f !important; }
      \  .email-checklist-checked { background-color: #193c34 !important; border-color: #00ba7c !important; }
      \}
    /[if mso]
      <xml>
      <o:OfficeDocumentSettings xmlns:o="urn:schemas-microsoft-com:office:office">
      <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
      </xml>
    = vite_stylesheet_tag 'styles/entrypoints/mailer.scss'
  %body
    .email{ dir: locale_direction }
      %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
        %tr
          %td.email-desktop-p-8
            .email-container
              /[if mso]
                <table border="0" cellpadding="0" cellspacing="0" align="center" style="width:740px;" role="presentation"><tr><td>
              %table.email-w-full.email-card-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-card-td.email-desktop-rounded-16px

                    -# Header
                    %table.email-header-table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                      %tr
                        %td.email-header-td

                          -# Logo
                          %table.email-header-logo-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                            %tr
                              %td.email-header-logo-td
                                /[if mso]
                                  <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="false" stroke="false" style="position:absolute; left:40px; top:26px; width:636px;"><v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0">
                                .email-header-logo-div
                                  %p.email-header-logo-p
                                    %span.email-header-logo-span
                                      = '/ '
                                      = site_hostname
                                /[if mso]
                                  </v:textbox></v:rect>
                                = link_to root_url, class: 'email-header-logo-a' do
                                  = image_tag frontend_asset_url('images/mailer-new/common/espelunca-icon.png'), alt: '', width: 40, height: 40
                                  %span.email-header-brand-text espelunca

                          -# Heading
                          = yield :heading

                    .email-header-after-div
                      .email-header-after-inside-div
                    %table.email-body-table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                      %tr
                        %td.email-body-td
                          -# Content
                          = yield

              /[if mso]
                </td></tr></table>

            -# Footer
            .email-container
              /[if mso]
                <table border="0" cellpadding="0" cellspacing="0" align="center" style="width:740px;" role="presentation"><tr><td>
              %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-footer-td
                    - if content_for?(:footer)
                      = yield :footer
                    - else
                      %p.email-footer-p
                        = link_to root_url, class: 'email-footer-logo-a' do
                          = image_tag frontend_asset_url('images/mailer-new/common/espelunca-icon.png'), alt: 'Espelunca', width: 44, height: 44
                      %p.email-footer-p
                        = t 'about.hosted_on', domain: site_hostname
                      %p.email-footer-p
                        = link_to t('application_mailer.notification_preferences'), settings_preferences_notifications_url
                        - if defined?(@unsubscribe_url)
                          ·
                          = link_to t('application_mailer.unsubscribe'), @unsubscribe_url
              /[if mso]
                </td></tr></table>

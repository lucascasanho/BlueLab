#!/usr/bin/env bash

# Atualizador idempotente do canal de testes do Blue.
# Canal remoto: BlueLab-Test

set -u

REPO="${BLUE_REPO:-$HOME/blue}"
REMOTE="${BLUE_REMOTE:-bluelab}"
REMOTE_URL="${BLUE_REMOTE_URL:-https://github.com/lucascasanho/BlueLab.git}"
BRANCH="${BLUE_TEST_BRANCH:-BlueLab-Test}"
INSTALL_DIR="${BLUE_INSTALL_DIR:-$HOME/.local/bin}"
INSTALL_PATH="$INSTALL_DIR/blue-atualizar"
SERVICES=(blue-web blue-sidekiq blue-streaming)

fail() {
  echo
  echo "ERRO: $*"
  echo "O terminal continuará aberto."
  exit 1
}

run() {
  "$@" || fail "falhou: $*"
}

echo "========================================"
echo " BLUE - ATUALIZAR CANAL DE TESTES"
echo "========================================"

cd "$REPO" || fail "não consegui entrar em $REPO"
git rev-parse --git-dir >/dev/null 2>&1 || fail "$REPO não é um repositório Git"

if [ -n "$(git status --porcelain)" ]; then
  echo
  echo "Existem alterações locais não commitadas:"
  git status --short
  fail "working tree não está limpa; nada foi atualizado"
fi

echo
echo "===== BUSCANDO $BRANCH ====="
if git remote get-url "$REMOTE" >/dev/null 2>&1; then
  run git fetch "$REMOTE" "$BRANCH"
  NEW_HEAD="$(git rev-parse FETCH_HEAD)"
else
  run git fetch "$REMOTE_URL" "$BRANCH"
  NEW_HEAD="$(git rev-parse FETCH_HEAD)"
fi

CURRENT_BRANCH="$(git branch --show-current)"
if [ "$CURRENT_BRANCH" != "$BRANCH" ]; then
  echo
  echo "===== MUDANDO PARA O CANAL DE TESTES ====="
  echo "branch atual: $CURRENT_BRANCH"
  echo "destino:      $BRANCH"

  if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    run git switch "$BRANCH"
  elif git remote get-url "$REMOTE" >/dev/null 2>&1 && \
       git show-ref --verify --quiet "refs/remotes/$REMOTE/$BRANCH"; then
    run git switch --track -c "$BRANCH" "$REMOTE/$BRANCH"
  else
    run git switch -c "$BRANCH" "$NEW_HEAD"
  fi
fi

OLD_HEAD="$(git rev-parse HEAD)"

if [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
  echo
  echo "===== VALIDANDO FAST-FORWARD ====="
  git merge-base --is-ancestor "$OLD_HEAD" "$NEW_HEAD" || \
    fail "o histórico local de $BRANCH divergiu do remoto; nenhuma atualização foi aplicada"

  run git diff --check "$OLD_HEAD..$NEW_HEAD"

  echo
  echo "===== APLICANDO CÓDIGO NOVO ====="
  run git merge --ff-only "$NEW_HEAD"
else
  echo
  echo "Nenhum commit novo. Vou validar/reaplicar o deploy atual para que o comando seja idempotente."
fi

# Mantém o comando disponível mesmo depois de trocar de branch ou reabrir o shell.
echo
echo "===== INSTALANDO COMANDO PERSISTENTE ====="
run mkdir -p "$INSTALL_DIR"
run install -m 0755 "$REPO/bin/blue-atualizar" "$INSTALL_PATH"
echo "instalado em: $INSTALL_PATH"

echo
echo "===== RUBY ====="
if ! bundle check; then
  run bundle install
fi

echo
echo "===== JAVASCRIPT ====="
run yarn install --immutable

echo
echo "===== MIGRATIONS ====="
run env RAILS_ENV=production bundle exec rails db:migrate

echo
echo "===== ASSETS ====="
run env RAILS_ENV=production NODE_ENV=production bundle exec rails assets:precompile

echo
echo "===== REINICIANDO BLUE ====="
run sudo systemctl restart "${SERVICES[@]}"

sleep 2

echo
echo "===== STATUS ====="
FAILED=0
for service in "${SERVICES[@]}"; do
  state="$(systemctl is-active "$service" 2>/dev/null || true)"
  printf '%-24s %s\n' "$service" "$state"
  if [ "$state" != "active" ]; then
    FAILED=1
  fi
done

if [ "$FAILED" -ne 0 ]; then
  fail "um ou mais serviços não ficaram ativos"
fi

echo
echo "===== VERSÃO ====="
git log -1 --oneline

echo
echo "========================================"
echo " BLUE ATUALIZADO E PRONTO PARA TESTE"
echo "========================================"

#!/usr/bin/env bash

# Atualizador seguro do BlueLab.
# Fluxo canônico: BlueLab-Test no Blue e BlueLab na Espelunca.
# Atualizações oficiais do Mastodon são verificadas sem alterar automaticamente
# o código BlueLab. Em caso de conflito, o comando gera um resumo para auxílio.
#
# Fontes:
# - https://git-scm.com/docs/git-merge
# - https://git-scm.com/docs/git-worktree
# - https://github.com/mastodon/mastodon

set -Eeuo pipefail

REMOTO="${BLUELAB_REMOTE:-bluelab}"
URL_REMOTO="${BLUELAB_REMOTE_URL:-https://github.com/lucascasanho/BlueLab.git}"
REMOTO_MASTODON="${BLUELAB_UPSTREAM_REMOTE:-mastodon-oficial}"
URL_MASTODON="${BLUELAB_UPSTREAM_URL:-https://github.com/mastodon/mastodon.git}"
CANAL_ESTAVEL="${BLUELAB_CANAL_ESTAVEL:-BlueLab}"
CANAL_TESTE="${BLUELAB_CANAL_TESTE:-BlueLab-Test}"
DIR_INSTALACAO="${BLUELAB_INSTALL_DIR:-$HOME/.local/bin}"
COMANDO_INSTALADO="$DIR_INSTALACAO/bluelab"
DIR_ESTADO="${BLUELAB_STATE_DIR:-$HOME/.local/state/bluelab}"
ACAO="${1:-atualizar}"

falhar() { echo; echo "ERRO: $*" >&2; exit 1; }
executar() { "$@" || falhar "falhou: $*"; }

cabecalho() {
  printf '\n============================================================\n %s\n============================================================\n\n' "$1"
}

selecionar_alvo() {
  case "${BLUELAB_TARGET:-}" in
    blue) ALVO=blue; REPO="${BLUELAB_REPO:-$HOME/blue}"; SERVICOS=(blue-web blue-sidekiq blue-streaming) ;;
    espelunca) ALVO=espelunca; REPO="${BLUELAB_REPO:-$HOME/espelunca}"; SERVICOS=(espelunca-web espelunca-sidekiq espelunca-streaming) ;;
    "")
      if [[ "${USER:-}" == blue && -d "$HOME/blue/.git" ]]; then
        ALVO=blue; REPO="${BLUELAB_REPO:-$HOME/blue}"; SERVICOS=(blue-web blue-sidekiq blue-streaming)
      elif [[ "${USER:-}" == espelunca && -d "$HOME/espelunca/.git" ]]; then
        ALVO=espelunca; REPO="${BLUELAB_REPO:-$HOME/espelunca}"; SERVICOS=(espelunca-web espelunca-sidekiq espelunca-streaming)
      elif [[ -n "${BLUELAB_REPO:-}" ]]; then
        REPO="$BLUELAB_REPO"
        case "$(basename "$REPO")" in
          blue) ALVO=blue; SERVICOS=(blue-web blue-sidekiq blue-streaming) ;;
          espelunca) ALVO=espelunca; SERVICOS=(espelunca-web espelunca-sidekiq espelunca-streaming) ;;
          *) falhar "defina BLUELAB_TARGET=blue ou espelunca" ;;
        esac
      else
        falhar "não consegui identificar Blue ou Espelunca"
      fi
      ;;
    *) falhar "BLUELAB_TARGET deve ser blue ou espelunca" ;;
  esac

  if [[ -n "${BLUELAB_CANAL:-}" ]]; then
    CANAL="$BLUELAB_CANAL"
  elif [[ -n "${BLUELAB_BRANCH:-}" ]]; then
    CANAL="$BLUELAB_BRANCH"
  elif [[ "$ALVO" == blue ]]; then
    CANAL="$CANAL_TESTE"
  else
    CANAL="$CANAL_ESTAVEL"
  fi
}

preparar_git() {
  cd "$REPO" || falhar "não consegui entrar em $REPO"
  git rev-parse --git-dir >/dev/null 2>&1 || falhar "$REPO não é um repositório Git"
  git remote get-url "$REMOTO" >/dev/null 2>&1 || executar git remote add "$REMOTO" "$URL_REMOTO"
  executar git fetch --prune --tags "$REMOTO" "+refs/heads/*:refs/remotes/$REMOTO/*"
}

preservar_local() {
  if [[ -n "$(git status --porcelain=v1)" ]]; then
    local nome="bluelab-reserva-local-${ALVO}-$(date +%Y%m%d-%H%M%S)"
    git status --short
    executar git stash push --include-untracked -m "$nome"
    echo "Alterações locais preservadas no stash: $nome"
  fi
}

instalar_comando_atual() {
  executar mkdir -p "$DIR_INSTALACAO"
  executar install -m 0755 "$REPO/bin/bluelab" "$COMANDO_INSTALADO"
}

capturar_configuracoes() {
  local destino="$1"
  local codigo="require 'json'; keys=%w[status_character_limit admin_status_character_limit hide_status_character_counter hide_admin_status_character_counter media_image_size_limit_mb media_video_size_limit_mb instance_accent_color instance_light_background_color instance_light_surface_color instance_light_text_color instance_dark_background_color instance_dark_surface_color instance_dark_text_color email_primary_color email_button_color email_link_color email_background_color email_surface_color email_text_color email_muted_color email_dark_background_color email_dark_surface_color email_dark_text_color email_dark_muted_color theme landing_page trends]; data=keys.to_h { |k| [k, Setting.public_send(k)] }; File.write(ENV.fetch('BLUELAB_ARQUIVO_CONFIG'), JSON.pretty_generate(data.sort.to_h)+\"\\n\")"
  executar mkdir -p "$DIR_ESTADO"
  BLUELAB_ARQUIVO_CONFIG="$destino" env RAILS_ENV=production bundle exec rails runner "$codigo" >/dev/null
  [[ -s "$destino" ]] || falhar "não foi possível registrar limites/cores do painel"
}

comparar_configuracoes() {
  local antes="$1" depois="$2"
  if ! cmp -s "$antes" "$depois"; then
    echo "As configurações administrativas mudaram durante a atualização:" >&2
    diff -u "$antes" "$depois" || true
    falhar "limites, cores ou outra configuração protegida não foi preservada"
  fi
  echo "Limites e cores do painel: preservados."
}

alinhar_codigo() {
  git show-ref --verify --quiet "refs/remotes/$REMOTO/$CANAL" || falhar "canal $CANAL não encontrado"
  local novo antigo
  novo="$(git rev-parse "$REMOTO/$CANAL")"
  antigo="$(git rev-parse HEAD)"

  if [[ "$novo" != "$antigo" ]] && ! git merge-base --is-ancestor "$antigo" "$novo" 2>/dev/null; then
    executar git branch "reserva/local-${ALVO}-$(date +%Y%m%d-%H%M%S)" "$antigo"
  fi

  if git show-ref --verify --quiet "refs/heads/$CANAL"; then
    executar git switch "$CANAL"
  else
    executar git switch --track -c "$CANAL" "$REMOTO/$CANAL"
  fi
  executar git reset --hard "$novo"
  executar git diff --check "$novo"
}

garantir_ruby() {
  local versao

  versao="$(cat "$REPO/.ruby-version" 2>/dev/null || true)"
  [[ -n "$versao" ]] || return 0

  if command -v rbenv >/dev/null 2>&1; then
    if ! rbenv versions --bare 2>/dev/null | grep -Fxq "$versao"; then
      rbenv commands 2>/dev/null | grep -Fxq "install" || falhar "a versão Ruby $versao é exigida por $REPO/.ruby-version, mas o plugin ruby-build não está disponível no rbenv"
      echo "Ruby $versao não está instalada. Instalando automaticamente via rbenv..."
      executar rbenv install -s "$versao"
    fi
    executar rbenv rehash
  else
    falhar "rbenv não está disponível e o repositório exige Ruby $versao"
  fi

  local ruby_real
  ruby_real="$(ruby -v 2>/dev/null || true)"
  echo "Ruby selecionado: $ruby_real"
}

atualizar_dependencias() {
  bundle check || executar bundle install
  executar yarn install --immutable
  executar env RAILS_ENV=production bundle exec rails db:migrate
  if [[ "$ALVO" == blue ]]; then
    executar env RAILS_ENV=production bin/tootctl email_domain_blocks sync_disposable
  fi
}

recompilar_assets() {
  executar env RAILS_ENV=production NODE_ENV=production bundle exec rails assets:clobber
  executar env RAILS_ENV=production bundle exec rails tmp:cache:clear
  executar env RAILS_ENV=production NODE_ENV=production bundle exec rails assets:precompile
  [[ -s "$REPO/public/packs/.vite/manifest.json" ]] || falhar "manifesto Vite não foi gerado"
}

reiniciar_servicos() {
  local s estado
  for s in "${SERVICOS[@]}"; do
    systemctl cat "$s" >/dev/null 2>&1 || falhar "serviço $s não existe"
  done
  executar "$REPO/bin/mastodon-install-systemd-readiness" "$ALVO"
  executar sudo systemctl restart "${SERVICOS[@]}"
  sleep 2
  for s in "${SERVICOS[@]}"; do
    estado="$(systemctl is-active "$s" 2>/dev/null || true)"
    printf '%-28s %s\n' "$s" "$estado"
    [[ "$estado" == active ]] || falhar "$s não ficou ativo"
  done
  executar env RAILS_ENV=production bundle exec rails runner "abort 'Rails não iniciou' unless defined?(Setting); puts 'Rails: OK'"
}

extrair_versao() {
  ruby -rrubygems -e '
    s=STDIN.read; f=->(n){s[/def #{Regexp.escape(n)}\s*\n\s*([^\n]+)/,1]&.strip&.gsub(/\A[\x27\x22]+|[\x27\x22]+\z/,"")};
    a=[f["major"],f["minor"],f["patch"]]; abort "versão ilegível" if a.any?(&:nil?); v=a.join("."); p=f["default_prerelease"]; v+="-#{p}" if p && p!="nil"; Gem::Version.new(v); puts v
  '
}

versao_atual() {
  extrair_versao <"$REPO/lib/mastodon/version.rb"
}

versao_main_oficial() {
  git show "$REMOTO_MASTODON/main:lib/mastodon/version.rb" | extrair_versao
}

maior_tag_oficial() {
  git for-each-ref --format='%(refname:strip=4)' "refs/remotes/$REMOTO_MASTODON/tags" | ruby -rrubygems -e '
    t=STDIN.each_line.map(&:strip).select{|x| x.match?(/\Av\d+\.\d+\.\d+(?:-(?:alpha|beta|rc)(?:[.-]?\d+(?:\.\d+)*)?)?\z/i)};
    m=t.max_by{|x| Gem::Version.new(x.delete_prefix("v"))}; puts m if m
  '
}

versao_maior() {
  ruby -rrubygems -e 'exit(Gem::Version.new(ARGV[0])>Gem::Version.new(ARGV[1]) ? 0 : 1)' "$1" "$2"
}

categoria() {
  case "$1" in
    db/migrate/*|db/schema.rb) echo "banco" ;;
    app/javascript/*|app/assets/*|app/views/*) echo "interface" ;;
    app/models/*|app/services/*|app/controllers/*|app/serializers/*|lib/*) echo "backend" ;;
    config/*) echo "configuração" ;;
    spec/*|test/*) echo "testes" ;;
    Gemfile*|package.json|yarn.lock) echo "dependências" ;;
    *) echo "outros" ;;
  esac
}

verificar_mastodon() {
  [[ "$ALVO" == blue ]] || return 0
  cabecalho "VERIFICAÇÃO DO MASTODON OFICIAL"

  if git remote get-url "$REMOTO_MASTODON" >/dev/null 2>&1; then
    executar git remote set-url "$REMOTO_MASTODON" "$URL_MASTODON"
  else
    executar git remote add "$REMOTO_MASTODON" "$URL_MASTODON"
  fi
  executar git fetch --prune "$REMOTO_MASTODON" \
    '+refs/heads/main:refs/remotes/'"$REMOTO_MASTODON"'/main' \
    '+refs/tags/v*:refs/remotes/'"$REMOTO_MASTODON"'/tags/v*'

  local atual versao_main tag versao_tag candidato_ref candidato_versao candidato_origem
  atual="$(versao_atual)"
  versao_main="$(versao_main_oficial)"
  tag="$(maior_tag_oficial)"
  versao_tag="${tag#v}"
  candidato_ref=""
  candidato_versao=""
  candidato_origem=""

  echo "BlueLab baseado em: $atual"
  echo "Versão declarada no main oficial: $versao_main"
  [[ -n "$tag" ]] && echo "Maior tag oficial publicada: $versao_tag"

  if versao_maior "$versao_main" "$atual"; then
    candidato_ref="refs/remotes/$REMOTO_MASTODON/main"
    candidato_versao="$versao_main"
    candidato_origem="main oficial"
  fi

  if [[ -n "$tag" ]] && versao_maior "$versao_tag" "$atual"; then
    if [[ -z "$candidato_versao" ]] || versao_maior "$versao_tag" "$candidato_versao"; then
      candidato_ref="refs/remotes/$REMOTO_MASTODON/tags/$tag"
      candidato_versao="$versao_tag"
      candidato_origem="tag oficial $tag"
    fi
  fi

  if [[ -z "$candidato_ref" ]]; then
    echo "Nenhuma versão oficial mais nova para analisar. Commits comuns sem mudança de versão são ignorados."
    return 0
  fi

  echo "Candidato encontrado: $candidato_versao ($candidato_origem)"

  local tmp codigo=0 relatorio
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/bluelab-upstream.XXXXXX")"
  executar git worktree add --detach "$tmp" "$REMOTO/$CANAL_TESTE" >/dev/null
  (cd "$tmp" && git -c user.name='BlueLab Atualizador' -c user.email='atualizador@localhost' merge --no-commit --no-ff "$candidato_ref" >/dev/null 2>&1) || codigo=$?

  if [[ "$codigo" -ne 0 ]]; then
    mapfile -t conflitos < <(git -C "$tmp" diff --name-only --diff-filter=U)
    relatorio="$DIR_ESTADO/conflitos-${candidato_versao}.txt"
    executar mkdir -p "$DIR_ESTADO"
    {
      echo "Mastodon: $candidato_versao ($candidato_origem)"
      echo "BlueLab teste: $(git rev-parse "$REMOTO/$CANAL_TESTE")"
      echo "Conflitos: ${#conflitos[@]}"
      echo
      for arq in "${conflitos[@]}"; do printf '[%s] %s\n' "$(categoria "$arq")" "$arq"; done
      echo
      echo "Pedido para IA: integre a versão oficial $candidato_versao ($candidato_origem) ao BlueLab preservando tema, compose, navegação, limites, cores e configurações administrativas. Não substitua arquivos customizados inteiros por versões upstream. Resolva os conflitos abaixo:"
      printf '%s\n' "${conflitos[@]}"
    } >"$relatorio"
    echo "Conflitos encontrados; nenhum canal foi alterado:"
    for arq in "${conflitos[@]}"; do printf '  - %-13s %s\n' "$(categoria "$arq")" "$arq"; done
    echo "Relatório para enviar à IA: $relatorio"
    git -C "$tmp" merge --abort >/dev/null 2>&1 || true
  else
    echo "A simulação da atualização $candidato_versao não encontrou conflitos textuais."
    echo "Ela não foi aplicada automaticamente; primeiro deve ser integrada ao canal de teste e validada."
    git -C "$tmp" merge --abort >/dev/null 2>&1 || true
  fi
  git worktree remove --force "$tmp" >/dev/null 2>&1 || true
}

atualizar() {
  cabecalho "BLUELAB — ATUALIZAÇÃO"
  echo "Instância: $ALVO"
  echo "Canal: $CANAL"
  preparar_git
  preservar_local

  # Primeiro alinhar o checkout com o canal correto. Só depois disso podem ser
  # executados Bundler/Rails, pois o próprio commit novo pode exigir outra versão
  # de Ruby definida em .ruby-version.
  alinhar_codigo
  instalar_comando_atual
  garantir_ruby

  local antes="$DIR_ESTADO/configuracoes-antes-${ALVO}.json"
  local depois="$DIR_ESTADO/configuracoes-depois-${ALVO}.json"
  capturar_configuracoes "$antes"

  atualizar_dependencias
  recompilar_assets
  reiniciar_servicos

  capturar_configuracoes "$depois"
  comparar_configuracoes "$antes" "$depois"
  executar mkdir -p "$DIR_ESTADO"
  git rev-parse HEAD >"$DIR_ESTADO/ultimo-implantado-${ALVO}.sha"

  git log -1 --format='commit: %H%ndata: %cd%nmensagem: %s' --date=iso
  if [[ "$ALVO" == blue ]]; then
    verificar_mastodon
    echo "Depois de testar este SHA, use 'bluelab promover' para promover o SHA testado ao canal estável."
  else
    echo "A Espelunca consulta somente o canal $CANAL_ESTAVEL."
  fi
}
promover() {
  [[ "$ALVO" == blue ]] || falhar "promoção só pode ser executada no mastodon.blue"
  preparar_git
  local teste estavel local_head implantado promovido
  teste="$(git rev-parse "$REMOTO/$CANAL_TESTE")"
  estavel="$(git rev-parse "$REMOTO/$CANAL_ESTAVEL")"
  local_head="$(git rev-parse HEAD)"
  implantado="$(cat "$DIR_ESTADO/ultimo-implantado-blue.sha" 2>/dev/null || true)"

  [[ "$local_head" == "$teste" ]] || falhar "o Blue não está no HEAD atual de $CANAL_TESTE"
  [[ "$implantado" == "$teste" ]] || falhar "$CANAL_TESTE mudou desde o último teste; atualize e teste novamente"
  git merge-base --is-ancestor "$estavel" "$teste" || falhar "os canais divergiram; promoção automática não é segura"
  [[ -z "$(git status --porcelain=v1)" ]] || falhar "há alterações locais"

  if [[ "$estavel" == "$teste" ]]; then
    echo "Canal $CANAL_ESTAVEL já está no SHA testado: $teste"
    return 0
  fi

  executar git push "$REMOTO" "$teste:refs/heads/$CANAL_ESTAVEL"
  executar git fetch --prune "$REMOTO" "+refs/heads/$CANAL_ESTAVEL:refs/remotes/$REMOTO/$CANAL_ESTAVEL"
  promovido="$(git rev-parse "$REMOTO/$CANAL_ESTAVEL")"
  [[ "$promovido" == "$teste" ]] || falhar "o GitHub não confirmou $CANAL_ESTAVEL no SHA testado"

  executar mkdir -p "$DIR_ESTADO"
  {
    echo "SHA_TESTADO=$teste"
    echo "SHA_ESTAVEL_ANTERIOR=$estavel"
    echo "SHA_PROMOVIDO=$promovido"
    echo "CANAL_ORIGEM=$CANAL_TESTE"
    echo "CANAL_DESTINO=$CANAL_ESTAVEL"
  } >"$DIR_ESTADO/promocao-pronta.txt"

  echo "Promoção concluída."
  echo "$CANAL_ESTAVEL agora aponta exatamente para o SHA testado: $promovido"
  echo "A Espelunca já pode executar 'bluelab' para receber esta versão."
  echo "Registro: $DIR_ESTADO/promocao-pronta.txt"
}

estado() {
  preparar_git
  printf '%-16s %s\n' "$CANAL_ESTAVEL" "$(git rev-parse "$REMOTO/$CANAL_ESTAVEL")"
  printf '%-16s %s\n' "$CANAL_TESTE" "$(git rev-parse "$REMOTO/$CANAL_TESTE")"
  printf '%-16s %s\n' local "$(git rev-parse HEAD)"
}

selecionar_alvo
case "$ACAO" in
  atualizar) atualizar ;;
  promover) promover ;;
  verificar-mastodon) preparar_git; verificar_mastodon ;;
  estado) estado ;;
  ajuda|-h|--help)
    echo "bluelab | bluelab atualizar | bluelab promover | bluelab verificar-mastodon | bluelab estado"
    ;;
  *) falhar "ação desconhecida: $ACAO" ;;
esac

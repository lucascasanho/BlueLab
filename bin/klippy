#!/usr/bin/env bash

# Configure e ativa o picker de GIF KLIPY em uma instalação Mastodon
# que contenha a integração BlueLab.
#
# Uso:
#   cd /caminho/da/instancia
#   klippy
#
# A chave é validada antes de qualquer alteração. Depois do build, os serviços
# web, Sidekiq e streaming ligados à mesma árvore Git são reiniciados.
#
# Fontes:
# - https://docs.klipy.com/
# - https://docs.klipy.com/stickers-api
# - https://www.freedesktop.org/software/systemd/man/systemctl.html

set -Eeuo pipefail

falhar() {
  echo
  echo "ERRO: $*" >&2
  exit 1
}

REPO="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO" ] || falhar "execute klippy dentro da árvore Git da instância"

[ -f "$REPO/.env.production" ] || falhar "não encontrei $REPO/.env.production"
[ -f "$REPO/app/javascript/mastodon/features/compose/redesign/gif_picker.tsx" ] || falhar "o picker KLIPY não está instalado nesta árvore"
command -v yarn >/dev/null 2>&1 || falhar "yarn não está disponível"
command -v ruby >/dev/null 2>&1 || falhar "ruby não está disponível"
command -v systemctl >/dev/null 2>&1 || falhar "systemctl não está disponível"

BRANCH="$(git -C "$REPO" branch --show-current)"
echo "Instalação detectada: $REPO"
echo "Branch: $BRANCH"
echo

SERVICES=""
WEB_FOUND=""

adicionar_servico() {
  local unit="$1"

  if [ -z "$SERVICES" ]; then
    SERVICES="$unit"
  else
    SERVICES="$SERVICES $unit"
  fi
}

echo "Detectando serviços da instância..."

while IFS= read -r unit; do
  [ -n "$unit" ] || continue
  case "$unit" in
    *-web.service|*-sidekiq.service|*-streaming.service|*-streaming@*.service)
      working_dir="$(systemctl show "$unit" -p WorkingDirectory --value 2>/dev/null || true)"
      exec_start="$(systemctl show "$unit" -p ExecStart --value 2>/dev/null || true)"

      if [ "$working_dir" = "$REPO" ] || [[ "$working_dir" == "$REPO/"* ]] || [[ "$exec_start" == *"$REPO"* ]]; then
        adicionar_servico "$unit"
        case "$unit" in
          *-web.service) WEB_FOUND=1 ;;
        esac
      fi
      ;;
  esac
done < <(
  {
    systemctl list-units --all --type=service --no-legend --plain 2>/dev/null | awk '{print $1}'
    systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '{print $1}'
  } | sed '/^$/d' | sort -u
)

[ -n "$WEB_FOUND" ] || falhar "não consegui identificar o serviço web desta instância"
[ -n "$SERVICES" ] || falhar "não consegui identificar serviços Mastodon ligados a $REPO"

echo "Serviços detectados:"
printf '  %s\n' $SERVICES
echo

read -rsp "Cole a chave da KLIPY: " KLIPY_KEY
echo
[ -n "$KLIPY_KEY" ] || falhar "a chave não pode estar vazia"

CURL_CONFIG="$(mktemp /tmp/klippy-curl.XXXXXX)"
CURL_RESPONSE="$(mktemp /tmp/klippy-response.XXXXXX)"
chmod 600 "$CURL_CONFIG" "$CURL_RESPONSE"

cat > "$CURL_CONFIG" <<EOF
silent
show-error
get
url = "https://api.klipy.com/v2/featured"
output = "$CURL_RESPONSE"
data-urlencode = "key:$KLIPY_KEY"
data-urlencode = "country:BR"
data-urlencode = "locale:pt_BR"
data-urlencode = "contentfilter:high"
data-urlencode = "media_filter:gif,tinygif"
data-urlencode = "limit:1"
EOF

unset KLIPY_KEY

echo
echo "Validando a chave na API da KLIPY..."

HTTP_CODE="$(curl --config "$CURL_CONFIG" --write-out '%{http_code}' 2>/dev/null || true)"

if [ "$HTTP_CODE" != "200" ]; then
  rm -f "$CURL_CONFIG" "$CURL_RESPONSE"
  falhar "KLIPY recusou a chave ou a API não respondeu com sucesso (HTTP $HTTP_CODE)"
fi

if ! ruby -rjson -e '
  payload = JSON.parse(File.read(ARGV.fetch(0)))
  abort unless payload["results"].is_a?(Array) && payload["results"].any?
' "$CURL_RESPONSE"; then
  rm -f "$CURL_CONFIG" "$CURL_RESPONSE"
  falhar "a chave foi aceita pelo servidor, mas a API não retornou um GIF válido"
fi

echo "OK: chave aceita pela API KLIPY."

KLIPY_KEY="$(sed -n 's/^data-urlencode = "key:\(.*\)"$/\1/p' "$CURL_CONFIG")"
rm -f "$CURL_CONFIG" "$CURL_RESPONSE"
[ -n "$KLIPY_KEY" ] || falhar "não consegui recuperar a chave validada"

TMP_ENV="$(mktemp /tmp/klippy-env.XXXXXX)"
chmod 600 "$TMP_ENV"

if grep -q '^VITE_KLIPY_API_KEY=' "$REPO/.env.production"; then
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" == VITE_KLIPY_API_KEY=* ]]; then
      printf 'VITE_KLIPY_API_KEY=%s\n' "$KLIPY_KEY" >> "$TMP_ENV"
    else
      printf '%s\n' "$line" >> "$TMP_ENV"
    fi
  done < "$REPO/.env.production"
else
  cat "$REPO/.env.production" > "$TMP_ENV"
  printf '\nVITE_KLIPY_API_KEY=%s\n' "$KLIPY_KEY" >> "$TMP_ENV"
fi

unset KLIPY_KEY
chmod 600 "$TMP_ENV"
mv "$TMP_ENV" "$REPO/.env.production"

echo
echo "OK: chave salva localmente."
echo "Recriando o bundle de produção..."

if ! (cd "$REPO" && yarn build:production); then
  falhar "o build falhou; nenhum serviço foi reiniciado"
fi

echo
echo "Build concluído. Reiniciando os serviços detectados..."

sudo systemctl restart $SERVICES

echo
echo "Aguardando os serviços..."
for tentativa in $(seq 1 20); do
  todos_ativos=1

  for unit in $SERVICES; do
    if ! systemctl is-active --quiet "$unit"; then
      todos_ativos=0
      break
    fi
  done

  if [ "$todos_ativos" = 1 ]; then
    echo
    printf '%-36s %s\n' "SERVIÇO" "ESTADO"
    for unit in $SERVICES; do
      printf '%-36s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
    done
    echo
    echo "KLIPY ativado com sucesso em $REPO."
    exit 0
  fi

  sleep 1
done

echo
echo "Estado dos serviços após a tentativa:"
for unit in $SERVICES; do
  printf '  %-34s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
done

falhar "um ou mais serviços não ficaram ativos após o reinício"

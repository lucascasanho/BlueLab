#!/usr/bin/env bash
set -euo pipefail

REPO="${BLUE_REPO:-$HOME/blue}"
REMOTE="${BLUE_REMOTE:-bluelab}"
BRANCH="${BLUE_TEST_BRANCH:-BlueLab-Test}"
TMP="${XDG_CACHE_HOME:-$HOME/.cache}/bluelab-status-blue-deploy-$$"

cleanup() {
  if [ -d "$TMP" ]; then
    git -C "$REPO" worktree remove --force "$TMP" >/dev/null 2>&1 || true
  fi
}

trap cleanup EXIT

if [ ! -d "$REPO/.git" ]; then
  echo "ERRO: $REPO não é o repositório do Blue."
  exit 1
fi

mkdir -p "$(dirname "$TMP")"

echo "===== BUSCANDO $BRANCH ====="
git -C "$REPO" fetch "$REMOTE" "$BRANCH"

git -C "$REPO" worktree add --detach "$TMP" FETCH_HEAD

echo
echo '===== VERSÃO QUE SERÁ PUBLICADA ====='
git -C "$TMP" log -1 --oneline

echo
bash "$TMP/status-page/scripts/deploy-blue.sh"

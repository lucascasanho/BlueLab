{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "bluelab-origin-fallback",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "BLUE_STATUS",
      "service": "bluelab-status-blue",
    },
    {
      "binding": "ESPELUNCA_STATUS",
      "service": "espelunca-status",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
